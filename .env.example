# Required: Hugging Face token with access to facebook/sam3.
HF_TOKEN=

# Required: Mapbox token with Geocoding and Tiles API access.
MAPBOX_TOKEN=

# Optional runtime configuration.
PORT=7860
HOST=0.0.0.0
MODEL_ID=facebook/sam3
# Example prompts: "asphalt pavement" or "parking lot".
SEGMENTATION_PROMPT=asphalt pavement
BATCH_SIZE=8
MIN_ZOOM=14
MAX_ZOOM=20
DEFAULT_ZOOM=18
CORS_ORIGINS=*
